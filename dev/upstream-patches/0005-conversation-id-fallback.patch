+var convUUIDRe = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+
+// TestConversationIDForKeyDerivation 会话 ID 是纯派生：同键恒同值（同一会话多轮
+// 恒同值）、异键异值、空键每次新值、形态恒为带连字符的 UUIDv4。
+//
+// 形态为什么必须是 UUID 而不是 32 hex：上游国际版 2026-10-16 起对出站做渠道校验，
+// 点名要 X-Conversation-ID；官方客户端抓包（5.8.4，约 350 条）里会话 id 是带连
+// 字符的 UUID，消息/请求 id 才是 32 hex（workbuddy2api-hub#381）。两种形态在抓包
+// 里并存，各保持原貌最不惹眼。
+func TestConversationIDForKeyDerivation(t *testing.T) {
+	a1 := ConversationIDForKey("会话键-1")
+	a2 := ConversationIDForKey("会话键-1")
+	if a1 != a2 {
+		t.Errorf("same session key should derive same id: %q vs %q", a1, a2)
+	}
+	b := ConversationIDForKey("会话键-2")
+	if b == a1 {
+		t.Errorf("different session keys should derive different ids: %q", b)
+	}
+	// 与聚合键族的派生互不串味：同一键下会话 ID 不能等于会话/轮级聚合 ID。
+	if RequestIDForKey("会话键-1") == a1 {
+		t.Error("conversation id collides with session-level request id")
+	}
+	// 空键：无会话可归属 → 每次新值，且仍是合法形态。
+	e1, e2 := ConversationIDForKey(""), ConversationIDForKey("")
+	if e1 == e2 {
+		t.Errorf("empty key should yield fresh values each call: %q", e1)
+	}
+	for _, id := range []string{a1, b, e1, e2, NewConversationID()} {
+		if !convUUIDRe.MatchString(id) {
+			t.Errorf("conversation id %q is not a valid hyphenated UUIDv4", id)
+		}
+	}
+}
+
+// TestConversationIDForKeyIsAccountAgnostic 派生只吃会话键、不吃账号：同一会话
+// 在换号/重试/降级时出站会话 ID 必须一致（与 X-Conversation-Request-ID 的既有
+// 口径相同）。这里以「同键两次派生恒同值」锁定该性质——派生函数没有账号入参，
+// 有账号入参就会破坏它。
+func TestConversationIDForKeyIsAccountAgnostic(t *testing.T) {
+	key := "u0:同一会话"
+	seen := map[string]bool{}
+	for i := 0; i < 8; i++ {
+		seen[ConversationIDForKey(key)] = true
+	}
+	if len(seen) != 1 {
+		t.Errorf("conversation id should be stable across calls, got %d distinct values", len(seen))
+	}
+}
