--- a/internal/session/ids.go
+++ b/internal/session/ids.go
@@ -223,3 +223,47 @@ func TurnRequestID(turnKey string) string {
 	sum := sha256.Sum256([]byte(deriveSalt + "|" + turnKey))
 	return hex.EncodeToString(sum[:16])
 }
+
+// formatUUIDv4 把 16 字节按 RFC 4122 打成带连字符的 UUID 文本（8-4-4-4-12 小写
+// hex），并置上 v4 版本位与变体位。会话 ID 用这个形态，消息/请求 ID 用 32 hex
+// （NewMessageID）——两种形态在官方客户端抓包里并存，各司其职（见 ConversationIDForKey）。
+func formatUUIDv4(b []byte) string {
+	b[6] = (b[6] & 0x0f) | 0x40 // version 4
+	b[8] = (b[8] & 0x3f) | 0x80 // RFC 4122 variant
+	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
+}
+
+// NewConversationID 生成一次性的会话 ID（带连字符的 UUIDv4 形态）。
+// 只在「无会话键可派生」时兜底用；有会话键一律走 ConversationIDForKey，
+// 以保住「同一会话多轮恒同值」的语义。
+func NewConversationID() string {
+	b := make([]byte, 16)
+	if _, err := cryptorand.Read(b); err != nil {
+		// 熵源故障的极端兜底：仍保证 16 字节有熵且形态合法（不 panic、不空串）。
+		n := uint64(rand.Uint64()) | 1
+		for i := 0; i < 8; i++ {
+			b[i] = byte(n >> (i * 8))
+			b[15-i] = byte(n >> ((7 - i) * 8))
+		}
+	}
+	return formatUUIDv4(b)
+}
+
+// ConversationIDForKey 返回会话键的稳定 conversation ID：sha256(盐|键) 前 16 字节，
+// 按 UUIDv4 形态格式化（与 RequestIDForKey / TurnRequestID 共用同一派生盐）。
+//   - 同 key：进程内恒派生同值 —— 同一会话多轮恒同值（X-Conversation-ID 的会话级语义）；
+//   - 异 key：各自独立，互不相同；
+//   - 空 key：返回一次性随机值（无会话可归属时不伪造「稳定」）。
+//
+// 形态为什么是带连字符的 UUID 而不是 32 hex：上游国际版 2026-10-16 起对出站做
+// 渠道校验，`X-Conversation-ID` 是点名要的字段之一；官方客户端抓包（5.8.4，约
+// 350 条，见 ardeyouxipianyi/workbuddy2api-hub#381）里会话 id 正是带连字符的
+// UUID（v4/v7 均被接受，版本号不参与校验），而消息/请求 id 是 32 hex。两种形态
+// 保持各自原貌最不惹眼。
+func ConversationIDForKey(key string) string {
+	if key == "" {
+		return NewConversationID()
+	}
+	sum := sha256.Sum256([]byte(deriveSalt + "|" + key))
+	return formatUUIDv4(sum[:16])
+}
