+// TestChatConversationIDDerivedStableWithoutClientID 客户端不带 conversationId
+// （OpenAI 兼容客户端——Codex / Cherry Studio 等的常态）时，出站 X-Conversation-ID
+// 由会话键**稳定派生**：同一会话两次请求恒同值、不同会话不同值、形态是带连字符
+// 的 UUIDv4。
+//
+// 为什么必须有：上游国际版 2026-10-16 起对出站做渠道校验，缺这个头即
+// 400 code=11128 "conversation id missing"（issue #193 生产实证、hub#381 抓包、
+// CangShui#20 A/B）。此前该头在客户端不给时直接**不发**——正是被拦的形态。
+func TestChatConversationIDDerivedStableWithoutClientID(t *testing.T) {
+	var captured []http.Header
+	up := &upstream.Client{
+		HTTP: &http.Client{Transport: roundTripFunc(func(r *http.Request) (*http.Response, error) {
+			captured = append(captured, r.Header.Clone())
+			return &http.Response{
+				StatusCode: 200,
+				Header:     http.Header{"Content-Type": []string{"text/event-stream"}},
+				Body:       io.NopCloser(strings.NewReader(sseOK)),
+			}, nil
+		})},
+		ChatBaseCN:    "https://fake.example",
+		BillingBaseCN: "https://fake.example",
+	}
+	p := testPoolWith(&auth.Auth{UID: "u1", AccessToken: "at1", ExpiresAt: 9999999999})
+	h := NewHandler(Config{Pool: p, Upstream: up})
+
+	send := func(userText string) {
+		t.Helper()
+		body := `{"model":"glm-5.2","stream":true,"messages":[{"role":"user","content":"` + userText + `"}]}`
+		req := httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(body))
+		rec := httptest.NewRecorder()
+		h.ServeHTTP(rec, req)
+		if rec.Code != 200 {
+			t.Fatalf("code=%d body=%s", rec.Code, rec.Body)
+		}
+	}
+
+	send("同一个开场白")
+	send("同一个开场白")
+	send("另一个开场白")
+
+	if len(captured) != 3 {
+		t.Fatalf("captured %d outbound requests, want 3", len(captured))
+	}
+	convIDRe := regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`)
+	first := captured[0].Get("X-Conversation-ID")
+	if !convIDRe.MatchString(first) {
+		t.Fatalf("X-Conversation-ID=%q want hyphenated UUIDv4 (缺失即上游 11128)", first)
+	}
+	if got := captured[1].Get("X-Conversation-ID"); got != first {
+		t.Errorf("同会话第二次出站 X-Conversation-ID=%q want %q（会话级应多轮稳定）", got, first)
+	}
+	if got := captured[2].Get("X-Conversation-ID"); got == first {
+		t.Errorf("不同会话出站 X-Conversation-ID 相同（%q）——应各自独立", got)
+	}
+}
